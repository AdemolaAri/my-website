---
import { getCollection } from 'astro:content';

import CallToAction from '../components/CallToAction.astro';
import ContactCTA from '../components/ContactCTA.astro';
import CredentialCard from '../components/CredentialCard.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const featuredCredentials = (await getCollection('credentials'))
	.filter((entry) => entry.data.featured)
	.sort((a, b) => {
		const aDate = a.data.date?.valueOf() ?? 0;
		const bDate = b.data.date?.valueOf() ?? 0;
		return bDate - aDate || a.data.title.localeCompare(b.data.title);
	})
	.slice(0, 4);
---

<BaseLayout
	title="About | Ademola Arigbabuwo"
	description="Learn more about Ademola Arigbabuwo, the systems he builds, and the learning trail that shapes his engineering work."
>
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				tagline="I build software across backend systems, product experiences, and AI workflows, with a bias toward clarity, useful abstractions, and work that earns trust in production."
			>
				<img
					width="1553"
					height="873"
					src="/assets/at-work.png"
					alt="Ademola Arigbabuwo working on software"
				/>
			</Hero>

			<section class="about-section">
				<h2 class="section-title"></h2>
				<div class="content stack gap-4">
					<p>
						I&apos;m a software engineer who likes working where architecture, product thinking, and execution all meet. Over the years, that has meant building backend services, event-driven systems, and user-facing tools that help teams move faster without making the system harder to reason about.
					</p>
					<p><b>My day-to-day instincts are pretty consistent: simplify the shape of the problem, make the data model pull its weight, and keep the path from idea to working software as short as possible. That has taken me from APIs and Spring Boot gateways to Angular frontends, config-driven interfaces, MongoDB-backed workflows, and the operational work around shipping software with confidence.</b></p>
					<p>
						Lately, a lot of that curiosity has been flowing into AI engineering. I&apos;m interested in the practical side of it: MCP servers, LLM tooling, retrieval, automation, and the design choices that make AI systems actually useful instead of merely flashy. I tend to learn in public, whether that&apos;s through tutorials, experiments, notebooks, or writing that turns a technical concept into something another engineer can apply quickly.
					</p>
					<p><b>
						Outside the terminal, I recharge with biking, tennis, and the kind of side-project ideation that starts as a small curiosity and occasionally turns into a real build. That mix keeps me grounded and keeps the work interesting. The throughline across all of it is simple: I like learning fast, building carefully, and leaving systems better than I found them.
					</b></p>
				</div>
			</section>

			<section class="credentials-preview stack gap-4">
				<div class="preview-header stack gap-2">
					<h2>Learning &amp; Credentials</h2>
					<p>
						I treat this as a curated proof trail rather than a badge wall: certifications, programs, talks, platform work, and selected learning that connect directly to how I build.
					</p>
				</div>

				<ul class="preview-grid">
					{
						featuredCredentials.map((entry) => (
							<li>
								<CredentialCard entry={entry} compact />
							</li>
						))
					}
				</ul>

				<div class="preview-cta">
					<CallToAction href="/credentials/">View All Credentials</CallToAction>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	.about-section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 1 / -1;
	}

	.credentials-preview {
		grid-column: 1 / -1;
		padding: 1.75rem;
		border-radius: 1.75rem;
		border: 1px solid var(--gray-800);
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	.preview-header {
		max-width: 50rem;
	}

	.preview-header p {
		color: var(--gray-300);
		font-size: var(--text-md);
	}

	.preview-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		padding: 0;
		list-style: none;
	}

	.preview-cta {
		display: flex;
		justify-content: flex-start;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		.about-section {
			display: contents;
			font-size: var(--text-lg);
		}

		.credentials-preview {
			padding: 2.5rem;
		}

		.preview-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.5rem;
		}
	}
</style>
