---
import type { CollectionEntry } from 'astro:content';

interface Props {
	entry: CollectionEntry<'credentials'>;
	compact?: boolean;
}

const { entry, compact = false } = Astro.props;
const { data } = entry;

const categoryLabels: Record<CollectionEntry<'credentials'>['data']['category'], string> = {
	certification: 'Certification',
	'ai-program': 'AI / LLM Program',
	ambassador: 'Ambassador Program',
	'platform-achievement': 'Platform Achievement',
	talk: 'Talk / Community',
	course: 'Selected Course',
};

const resolveCta = () => {
	if (!data.credentialUrl) return null;

	if (data.source === 'credly') return 'Verify';
	if (data.source === 'github' || data.source === 'kaggle' || data.source === 'linkedin') {
		return 'View profile';
	}
	if (data.source === 'youtube' || data.category === 'talk') return 'Watch talk';
	if (data.source === 'course' || data.category === 'course') return 'See course';

	return 'View credential';
};

const ctaLabel = resolveCta();
---

<article class:list={['credential-card', { compact }]}>
	<div class="card-top">
		<span class="category">{categoryLabels[data.category]}</span>
		{data.date && (
			<time datetime={data.date.toISOString()}>{data.date.toLocaleDateString('en-US', {
				year: 'numeric',
				month: 'short',
			})}</time>
		)}
	</div>

	{data.image && (
		<div class="image-wrap">
			<img src={data.image} alt={data.imageAlt || ''} loading="lazy" decoding="async" />
		</div>
	)}

	<div class="copy">
		<h3>{data.title}</h3>
		<p class="issuer">{data.issuer}</p>
		{data.description && <p class="description">{data.description}</p>}
	</div>

	{data.credentialUrl && ctaLabel && (
		<a href={data.credentialUrl} target="_blank" rel="noreferrer" class="credential-link">
			{ctaLabel}
		</a>
	)}
</article>

<style>
	.credential-card {
		display: grid;
		gap: 1rem;
		height: 100%;
		padding: 1.25rem;
		background:
			linear-gradient(180deg, color-mix(in srgb, var(--gray-999) 92%, transparent), transparent),
			var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 1.25rem;
		box-shadow: var(--shadow-sm);
	}

	.credential-card.compact {
		padding: 1.125rem;
	}

	.card-top {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		font-size: var(--text-sm);
		color: var(--gray-400);
	}

	.category {
		display: inline-flex;
		align-items: center;
		padding: 0.35rem 0.7rem;
		border-radius: 999rem;
		border: 1px solid var(--gray-800);
		background: color-mix(in srgb, var(--gray-999) 82%, transparent);
		color: var(--gray-200);
	}

	.image-wrap {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 4rem;
		padding: 0.75rem;
		border-radius: 1rem;
		background: color-mix(in srgb, var(--gray-900) 55%, transparent);
		border: 1px solid color-mix(in srgb, var(--gray-700) 40%, transparent);
	}

	.image-wrap img {
		max-height: 3rem;
		object-fit: contain;
	}

	.copy {
		display: grid;
		gap: 0.45rem;
	}

	.copy h3 {
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.compact .copy h3 {
		font-size: var(--text-lg);
	}

	.issuer {
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--gray-400);
	}

	.description {
		color: var(--gray-200);
	}

	.credential-link {
		display: inline-flex;
		align-items: center;
		width: fit-content;
		margin-top: auto;
		color: var(--gray-100);
		font-weight: 600;
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition: border-color var(--theme-transition);
	}

	.credential-link:hover,
	.credential-link:focus {
		border-color: currentColor;
	}

	@media (min-width: 50em) {
		.credential-card {
			padding: 1.5rem;
			border-radius: 1.5rem;
		}
	}
</style>
