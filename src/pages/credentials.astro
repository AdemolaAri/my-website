---
import { getCollection, type CollectionEntry } from 'astro:content';

import CredentialCard from '../components/CredentialCard.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const credentials = (await getCollection('credentials')).sort((a, b) => {
	const aDate = a.data.date?.valueOf() ?? 0;
	const bDate = b.data.date?.valueOf() ?? 0;
	return bDate - aDate || a.data.title.localeCompare(b.data.title);
});

const sections: Array<{
	key: CollectionEntry<'credentials'>['data']['category'];
	title: string;
	description: string;
}> = [
	{
		key: 'ai-program',
		title: 'AI / LLM Programs',
		description: 'Programs and deep dives that sharpen how I build practical AI systems.',
	},
	{
		key: 'certification',
		title: 'Certifications',
		description: 'Formal validations, skill checks, and structured proof of hands-on work.',
	},
	// {
	// 	key: 'ambassador',
	// 	title: 'Ambassador Programs',
	// 	description: 'Community and ecosystem programs where advocacy and technical leadership overlap.',
	// },
	{
		key: 'platform-achievement',
		title: 'Platform Achievements',
		description: 'Public signals of applied work across GitHub, Kaggle, and similar platforms.',
	},
	{
		key: 'talk',
		title: 'Talks / Community',
		description: 'Talks, videos, and community-facing explainers that turn technical work into shared learning.',
	},
	// {
	// 	key: 'course',
	// 	title: 'Selected Courses',
	// 	description: 'A curated subset of learning that materially shaped how I approach the work.',
	// },
];
---

<BaseLayout
	title="Credentials | Ademola Arigbabuwo"
	description="A curated collection of certifications, AI programs, recognitions, talks, and selected learning highlights."
>
	<main class="wrapper credentials-page stack gap-20">
		<Hero
			title="Credentials"
			tagline="A curated body of certifications, programs, talks, community work, and selected learning that reflects how I keep sharpening the craft."
			align="start"
		/>

		<div class="sections stack gap-15">
			{
				sections.map((section) => {
					const items = credentials.filter((entry) => entry.data.category === section.key);

					return (
						<section class="credential-section">
							<div class="section-copy stack gap-2">
								<h2>{section.title}</h2>
								<p>{section.description}</p>
							</div>

							{items.length > 0 ? (
								<ul class="credentials-grid">
									{items.map((entry) => (
										<li>
											<CredentialCard entry={entry} />
										</li>
									))}
								</ul>
							) : (
								<p class="empty-state">
									No public entries in this category yet. I keep the page curated rather than padded.
								</p>
							)}
						</section>
					);
				})
			}
		</div>
	</main>
</BaseLayout>

<style>
	.credentials-page {
		padding-bottom: 3rem;
	}

	.sections {
		position: relative;
	}

	.sections::before {
		content: '';
		position: absolute;
		inset: -4rem 50% auto;
		width: 100vw;
		height: 20rem;
		transform: translateX(-50%);
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--bg-image-subtle-1) center center / var(--bg-gradient-size) no-repeat;
		mix-blend-mode: var(--bg-blend-mode);
		opacity: 0.65;
		z-index: -1;
	}

	.credential-section {
		display: grid;
		gap: 1.5rem;
	}

	.section-copy {
		max-width: 54rem;
	}

	.section-copy h2 {
		font-size: var(--text-2xl);
	}

	.section-copy p,
	.empty-state {
		color: var(--gray-300);
		font-size: var(--text-md);
	}

	.credentials-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		padding: 0;
		list-style: none;
	}

	.empty-state {
		padding: 1.25rem;
		border: 1px dashed var(--gray-700);
		border-radius: 1rem;
		background: color-mix(in srgb, var(--gray-999) 86%, transparent);
	}

	@media (min-width: 50em) {
		.credential-section {
			gap: 2rem;
		}

		.credentials-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.5rem;
		}
	}
</style>
